# ISSU v0.2 — Production Readiness environment template.
# Copy to `.env` (git-ignored) and fill in real values OUTSIDE the repository.
# NEVER commit real credentials. Key VALUES are read from your environment at
# call time by Phase 1 `getSecret`; this file only documents NAMES.

# --- Runtime environment ---------------------------------------------------
# development | staging | production   (default: development)
ISSU_ENV=development

# --- Provider selection ----------------------------------------------------
# anthropic | openai | local           (default: local — deterministic stub)
ISSU_PROVIDER=local

# Required when ISSU_PROVIDER is not "local":
# The NAME of the env var that holds the API key (never the key itself).
# ISSU_PROVIDER_MODEL=claude-sonnet-4-5
# ISSU_PROVIDER_API_KEY_VAR=ANTHROPIC_API_KEY

# --- Bounds ----------------------------------------------------------------
# Timeout per provider call, 1000..60000 ms (default: 30000).
# ISSU_TIMEOUT_MS=30000
# Bounded retries for transient failures, 0..5 (default: 2).
# ISSU_MAX_RETRIES=2

# --- Workspace -------------------------------------------------------------
# Optional repository root for preflight workspace verification.
# Must resolve inside the current working directory.
# ISSU_WORKSPACE_ROOT=./
