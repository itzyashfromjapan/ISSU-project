# ISSU environment variables (Phase 1). Values here are placeholders only.
#
# Real values belong in a local, gitignored `.env` (loaded with Node's
# `--env-file-if-exists`) or exported in the shell. Never commit real secrets.

# Log threshold: trace | debug | info | warn | error | fatal (default: info).
ISSU_LOG_LEVEL=info

# Pretty, human-readable log output instead of JSON lines (default: false).
ISSU_LOG_PRETTY=false

# Path to the config file; overrides ./issue.config.json discovery (default: none).
# ISSU_CONFIG=./issue.config.json

# Extra comma-separated redaction keys/values applied to every log line.
# ISSU_REDACT=password,apiKey

# Secret variables: any name matching the secret convention (e.g. *KEY*, *TOKEN*,
# *SECRET*, *PASSWORD*) is auto-added to the logging redaction list. Example:
# ISSU_API_KEY=replace-with-a-real-value-in-.env
